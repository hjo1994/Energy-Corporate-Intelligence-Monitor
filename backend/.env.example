# Vorlage für die lokale .env und Quelle für configmap.env/secret.env im Cluster.
# Konvention (Portierungsdoku): Zeilen mit "# secret: ja" gehören ins Secret,
# alles andere in die ConfigMap.

# Pfad der geteilten SQLite-Datei (Interim, RWX-Volume; das Backend schreibt nur in
# UserActionExtracts).
AI_COCKPIT_DB_PATH=/data/db/ai_cockpit.db

# Eingabemaske „+ New initiative“ (POST /api/initiatives schreibt in die DB).
# Default true; false nur als Notbremse (blendet die Maske aus, POST -> 403).
AI_COCKPIT_ENABLE_INITIATIVE_INPUT=true

# --- Auth (eg-auth) ---
# Im Cluster: False. True umgeht die OIDC-Prüfung — nur lokal.
EG_AUTH_DEV_MODE=True
EG_AUTH_DEV_GROUPS=["app_50hzt_aap_communities_all__x"]
# Nur lokal, optional: Name und E-Mail des Dev-Nutzers (ersetzt EG_AUTH_DEV_GROUPS).
# EG_AUTH_DEV_USERS=[{"name": "Jonas", "email": "jonas@demo.local", "groups": []}]

# --- Rechte ---
# Approver per E-Mail oder SSO-Name (wie in /api/auth/rights "email" / "user"), kommagetrennt;
# wird beim Login als Role = approver in AppUser gespeichert (z. B. der erste Approver).
AI_COCKPIT_APPROVERS=
# AD-Gruppen, kommagetrennt:
# Approver: Inbox /api/approvals, Freigabe/Ablehnung (POST /api/use-cases/{id}/decision).
AI_COCKPIT_APPROVER_GROUPS=
# Admins: alles wie Approver, dazu jeden Use Case bearbeiten.
AI_COCKPIT_ADMIN_GROUPS=
# Demo-Presenter: SSO-Anzeigenamen (wie in /api/auth/rights "user"), E-Mail-Adressen oder AD-Gruppen, die ihre Sitzung für eine Demo in den
# Approver-Modus schalten dürfen (Header X-Demo-Role: approver); ohne Header sind sie normale Nutzer. Leer = niemand.
AI_COCKPIT_DEMO_PRESENTERS=
