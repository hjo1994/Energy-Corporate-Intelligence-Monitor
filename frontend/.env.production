# Build-time values (Vite bakes VITE_* into the bundle — they must reach the BUILD,
# not the running pod).
# Backend and frontend are served from the same origin, so a relative path is enough.
VITE_API="/api"

# OIDC (eg-auth-react): register an own OIDC client for this app and enter its
# values here on the company side. The redirect URI is window.location.origin + "/"
# and must be registered exactly, once per stage/domain.
VITE_OIDC_CLIENT_ID="yfbKlFDd4fVc0O8R84rocOBq"
VITE_OIDC_AUTHORITY="https://aap-authenticator.aap-prod.corp.transmission-it.de/api/v2"
VITE_OIDC_REQUEST_GROUPS="app_50hzt_aap_communities_all__x"
